# =============================================================================
# FlatCAM Evo Beta — .gitignore
# =============================================================================


# --- Python bytecode ---
__pycache__/
*.py[cod]
*.pyo
*.pyd


# --- Virtual environments ---
.venv/
venv/
env/
ENV/


# --- pip / setuptools / packaging artifacts ---
*.egg
*.egg-info/
dist-info/
.eggs/
pip-wheel-metadata/


# --- Build outputs (cx_Freeze, PyInstaller, general) ---
/build/
/dist/
/installer_output/

# PyInstaller spec (generated; track manually if you customize it)
FlatCAM.spec

# Build scripts that are machine-local
/setup_cx.py
/flatcam.iss
/flatcam.nsi

# Compiled installer binaries — never commit
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage


# --- Windows launcher (generated by setup_windows.ps1) ---
/run_flatcam.bat
/FlatCAM.lnk


# --- FlatCAM runtime files ---
# In normal mode FlatCAM writes to %APPDATA%\FlatCAM, not the repo.
# Direct repository runs use portable mode and write mutable state to /config.
# Keep configuration.txt tracked, but ignore generated preferences, databases,
# history, logs, and copied preprocessors.
*.FlatConfig
*.FlatDB
/config/recent.json
/config/recent_projects.json
/config/log.txt
/config/factory_defaults_*.FlatConfig
/config/current_defaults_*.FlatConfig
/config/tools_db_*.FlatDB
/config/preprocessors/


# --- Log files ---
*.log
log.txt


# --- IDE and editor files ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject
.ropeproject


# --- OS-generated files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory


# --- Test artifacts ---
tests/tmp/
.pytest_cache/
.tox/
.coverage
coverage.xml
htmlcov/
.hypothesis/


# --- Type checking / linting ---
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/


# --- Documentation build ---
doc/_build/
doc/build/


# --- Conda ---
.conda/


# --- uv ---
.uv/
uv.lock


# --- Local secrets / environment ---
.env
.env.local
secrets.py


# --- Compiled translations ---
# .mo files are compiled from .po at install time on Linux.
# On Windows we ship pre-compiled .mo files so they ARE tracked.
# Uncomment only if regenerating .mo files from CI:
# locale/**/*.mo
